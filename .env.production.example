# ============================================================
# TAccounts 生產環境設定範本
# 1. cp .env.production.example .env.production
# 2. 填入所有值（金鑰用 openssl 產生，指令見下方註解）
# 3. chmod 600 .env.production —— 此檔由 docker compose 的 env_file 載入，切勿提交 git
# ============================================================

# ---------- PostgreSQL（db 容器初始化，POSTGRES_* 只在第一次建 volume 時生效） ----------
# 密碼請用 URL-safe 字元：openssl rand -hex 24
POSTGRES_USER=taccounts
POSTGRES_PASSWORD=請更換為openssl_rand_hex_24
POSTGRES_DB=taccounts

# app / migrate 連線；host 必須是 compose service 名稱 db
DATABASE_URL=postgresql://taccounts:請更換為同上密碼@db:5432/taccounts?schema=public&connect_timeout=5

# ---------- Auth.js / 應用金鑰（全部用 openssl rand -base64 32 產生） ----------
# AUTH_SECRET：更換 = 全部 session 與密碼重設 token 失效
AUTH_SECRET=請更換為openssl_rand_base64_32
INVITE_SECRET=請更換為openssl_rand_base64_32
# AES-256-GCM 金鑰；base64 解碼後必須剛好 32 bytes。
# 一旦有使用者啟用 MFA 就不可更換，否則既有 mfaSecretEnc 無法解密。
MFA_ENC_KEY=請更換為openssl_rand_base64_32

# ---------- 站台網址（必須與 NPM Proxy Host 的網域完全一致，https 開頭） ----------
# AUTH_URL 決定 Auth.js 是否使用 __Secure- session cookie
AUTH_URL=https://erp.example.com
APP_URL=https://erp.example.com

# ---------- Redis（compose 內部網路，不暴露到主機） ----------
REDIS_URL=redis://redis:6379

# ---------- 首次安裝防護（強烈建議設定：openssl rand -hex 24） ----------
# /setup 頁只在 users=0 時開放；完成後此值可從環境移除
SETUP_TOKEN=請更換為openssl_rand_hex_24

# ---------- SMTP（選填；正式環境強烈建議） ----------
# 警告：未設定 SMTP_HOST 時，忘記密碼 API 會把重設連結直接回傳（devLink），
# 等同任何人可以接管帳號，正式環境務必設定。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TAccounts <no-reply@example.com>

# ---------- Stripe（選填；未設定時付款功能停用，API 回 503） ----------
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
